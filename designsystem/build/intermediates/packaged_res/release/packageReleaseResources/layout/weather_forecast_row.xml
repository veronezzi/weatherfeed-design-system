<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_weather_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/weather_spacing_md"
    android:paddingVertical="@dimen/weather_spacing_md">

    <!-- Day + Date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_day_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WeatherText.Title"
            android:text="Hoje" />

        <TextView
            android:id="@+id/tv_day_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WeatherText.Caption"
            android:text="22 Jun" />
    </LinearLayout>

    <!-- Icon -->
    <TextView
        android:id="@+id/tv_condition_icon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:gravity="center"
        android:text="⛅"
        android:textSize="22sp" />

    <!-- Condition label -->
    <TextView
        android:id="@+id/tv_condition_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        style="@style/WeatherText.Body"
        android:text="Parc. nublado" />

    <!-- Temp max -->
    <TextView
        android:id="@+id/tv_temp_max"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/weather_spacing_sm"
        style="@style/WeatherText.Title"
        android:text="25°" />

    <!-- Temp min -->
    <TextView
        android:id="@+id/tv_temp_min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/WeatherText.Caption"
        android:text="18°" />

</LinearLayout>
