<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/weather_top_bar_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/weather_spacing_md">

    <TextView
        android:id="@+id/tv_location_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍"
        android:textSize="@dimen/weather_text_body" />

    <TextView
        android:id="@+id/tv_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/weather_spacing_xs"
        android:layout_weight="1"
        style="@style/WeatherText.Title"
        android:text="São Paulo, Brasil" />

    <FrameLayout
        android:id="@+id/btn_search"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_weather_icon_circle"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🔍"
            android:textSize="@dimen/weather_text_body" />
    </FrameLayout>

</LinearLayout>
