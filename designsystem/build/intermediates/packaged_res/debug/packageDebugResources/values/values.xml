<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="weather_accent_blue">#5B9EF0</color>
    <color name="weather_accent_cyan">#64B5F6</color>
    <color name="weather_accent_orange">#FF8C42</color>
    <color name="weather_background_dark">#0D1230</color>
    <color name="weather_background_deep">#0A0F28</color>
    <color name="weather_divider">#1E2845</color>
    <color name="weather_gradient_end">#7B2FCA</color>
    <color name="weather_gradient_start">#3B4BC8</color>
    <color name="weather_nav_active_pill">#2D3A6E</color>
    <color name="weather_overlay">#33FFFFFF</color>
    <color name="weather_surface_card">#1A2040</color>
    <color name="weather_surface_elevated">#1E2845</color>
    <color name="weather_text_muted">#4A5580</color>
    <color name="weather_text_primary">#FFFFFF</color>
    <color name="weather_text_secondary">#8892B0</color>
    <dimen name="weather_component_height">52dp</dimen>
    <dimen name="weather_icon_circle_size">40dp</dimen>
    <dimen name="weather_nav_height">64dp</dimen>
    <dimen name="weather_radius_lg">20dp</dimen>
    <dimen name="weather_radius_md">16dp</dimen>
    <dimen name="weather_radius_pill">50dp</dimen>
    <dimen name="weather_radius_sm">8dp</dimen>
    <dimen name="weather_spacing_lg">24dp</dimen>
    <dimen name="weather_spacing_md">16dp</dimen>
    <dimen name="weather_spacing_sm">8dp</dimen>
    <dimen name="weather_spacing_xl">32dp</dimen>
    <dimen name="weather_spacing_xs">4dp</dimen>
    <dimen name="weather_spacing_xxl">48dp</dimen>
    <dimen name="weather_text_body">14sp</dimen>
    <dimen name="weather_text_body_large">16sp</dimen>
    <dimen name="weather_text_caption">12sp</dimen>
    <dimen name="weather_text_display">72sp</dimen>
    <dimen name="weather_text_headline">24sp</dimen>
    <dimen name="weather_text_label">11sp</dimen>
    <dimen name="weather_text_title">17sp</dimen>
    <dimen name="weather_top_bar_height">56dp</dimen>
    <style name="WeatherText"/>
    <style name="WeatherText.Body">
        <item name="android:textColor">@color/weather_text_secondary</item>
        <item name="android:textSize">@dimen/weather_text_body</item>
    </style>
    <style name="WeatherText.BodyLarge">
        <item name="android:textColor">@color/weather_text_primary</item>
        <item name="android:textSize">@dimen/weather_text_body_large</item>
    </style>
    <style name="WeatherText.Caption">
        <item name="android:textColor">@color/weather_text_secondary</item>
        <item name="android:textSize">@dimen/weather_text_caption</item>
    </style>
    <style name="WeatherText.Display">
        <item name="android:textColor">@color/weather_text_primary</item>
        <item name="android:textSize">@dimen/weather_text_display</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WeatherText.Headline">
        <item name="android:textColor">@color/weather_text_primary</item>
        <item name="android:textSize">@dimen/weather_text_headline</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WeatherText.ScreenTitle">
        <item name="android:textColor">@color/weather_accent_orange</item>
        <item name="android:textSize">@dimen/weather_text_headline</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WeatherText.SectionLabel">
        <item name="android:textColor">@color/weather_accent_cyan</item>
        <item name="android:textSize">@dimen/weather_text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="WeatherText.Title">
        <item name="android:textColor">@color/weather_text_primary</item>
        <item name="android:textSize">@dimen/weather_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>