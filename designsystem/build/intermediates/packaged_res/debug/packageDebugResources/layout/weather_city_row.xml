<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_weather_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/weather_spacing_md"
    android:paddingVertical="@dimen/weather_spacing_md">

    <!-- Icon circle -->
    <FrameLayout
        android:layout_width="@dimen/weather_icon_circle_size"
        android:layout_height="@dimen/weather_icon_circle_size"
        android:background="@drawable/bg_weather_icon_circle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📍"
            android:textSize="@dimen/weather_text_body" />
    </FrameLayout>

    <!-- City + Country -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/weather_spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WeatherText.Title"
            android:text="São Paulo" />

        <TextView
            android:id="@+id/tv_country"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WeatherText.Caption"
            android:text="Brasil" />
    </LinearLayout>

</LinearLayout>
