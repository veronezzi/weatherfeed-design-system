<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_weather_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/weather_spacing_md"
    android:paddingVertical="@dimen/weather_spacing_md">

    <!-- Icon circle -->
    <FrameLayout
        android:layout_width="@dimen/weather_icon_circle_size"
        android:layout_height="@dimen/weather_icon_circle_size"
        android:background="@drawable/bg_weather_icon_circle">

        <TextView
            android:id="@+id/tv_settings_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🌡"
            android:textSize="@dimen/weather_text_body_large" />
    </FrameLayout>

    <!-- Title + Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/weather_spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WeatherText.Title"
            android:text="Unidade de temperatura" />

        <TextView
            android:id="@+id/tv_settings_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/WeatherText.Caption"
            android:text="Celsius ou Fahrenheit" />
    </LinearLayout>

    <!-- Trailing slot (add TemperatureToggleView here programmatically) -->
    <FrameLayout
        android:id="@+id/fl_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
