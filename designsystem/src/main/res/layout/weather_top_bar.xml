<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/weather_top_bar_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/weather_spacing_md">

    <ImageView
        android:id="@+id/iv_location_pin"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_pin"
        app:tint="@color/weather_accent_blue" />

    <TextView
        android:id="@+id/tv_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/weather_spacing_xs"
        android:layout_weight="1"
        style="@style/WeatherText.Title"
        android:text="São Paulo, Brasil" />

    <FrameLayout
        android:id="@+id/btn_search"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_weather_icon_circle"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_search"
            app:tint="@color/weather_text_primary" />
    </FrameLayout>

</LinearLayout>
