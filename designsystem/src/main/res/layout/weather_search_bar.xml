<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/weather_component_height"
    android:background="@drawable/bg_weather_search_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/weather_spacing_md">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔍"
        android:textSize="@dimen/weather_text_body" />

    <EditText
        android:id="@+id/et_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/weather_spacing_sm"
        android:layout_weight="1"
        android:background="@null"
        android:hint="Buscar cidade ou país..."
        android:textColorHint="@color/weather_text_secondary"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/weather_text_primary"
        android:textSize="@dimen/weather_text_body_large" />

</LinearLayout>
