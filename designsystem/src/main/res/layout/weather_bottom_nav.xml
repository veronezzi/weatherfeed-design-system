<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/weather_nav_height"
    android:background="@color/weather_background_deep"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Item 1: Clima -->
    <LinearLayout
        android:id="@+id/nav_item_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/nav_pill_0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_weather_nav_pill">

            <ImageView
                android:id="@+id/nav_icon_0"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_weather_cloud"
                app:tint="@color/weather_accent_blue" />
        </FrameLayout>

        <TextView
            android:id="@+id/nav_label_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Clima"
            android:textColor="@color/weather_accent_blue"
            android:textSize="@dimen/weather_text_caption" />
    </LinearLayout>

    <!-- Item 2: 5 Dias -->
    <LinearLayout
        android:id="@+id/nav_item_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/nav_pill_1"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/nav_icon_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_weather_calendar"
                app:tint="@color/weather_text_secondary" />
        </FrameLayout>

        <TextView
            android:id="@+id/nav_label_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="5 Dias"
            android:textColor="@color/weather_text_secondary"
            android:textSize="@dimen/weather_text_caption" />
    </LinearLayout>

    <!-- Item 3: Buscar -->
    <LinearLayout
        android:id="@+id/nav_item_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/nav_pill_2"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/nav_icon_2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_weather_search"
                app:tint="@color/weather_text_secondary" />
        </FrameLayout>

        <TextView
            android:id="@+id/nav_label_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Buscar"
            android:textColor="@color/weather_text_secondary"
            android:textSize="@dimen/weather_text_caption" />
    </LinearLayout>

    <!-- Item 4: Ajustes -->
    <LinearLayout
        android:id="@+id/nav_item_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/nav_pill_3"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/nav_icon_3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_weather_settings"
                app:tint="@color/weather_text_secondary" />
        </FrameLayout>

        <TextView
            android:id="@+id/nav_label_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ajustes"
            android:textColor="@color/weather_text_secondary"
            android:textSize="@dimen/weather_text_caption" />
    </LinearLayout>

</LinearLayout>
