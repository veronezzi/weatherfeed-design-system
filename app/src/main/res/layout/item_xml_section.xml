<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp">

    <!-- Header do card (clicável para expandir) -->
    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_weather_card"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_component_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/WeatherText.Title"
                android:text="ComponentName" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/WeatherText.Caption"
                android:text="Descrição do componente" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_weather_stat_card"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            style="@style/WeatherText.SectionLabel"
            android:text="Category" />
    </LinearLayout>

    <!-- Preview (inicialmente GONE, toggle ao clicar no header) -->
    <LinearLayout
        android:id="@+id/ll_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/weather_background_deep"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone" />

</LinearLayout>
